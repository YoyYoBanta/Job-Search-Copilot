# ==============================================================================
# PHASE 1 VARIABLES (Required for Phase 1)
# ==============================================================================

# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Access Control (Single-User Whitelist - Required in Phase 1)
ALLOWED_EMAIL=your-email@example.com


# ==============================================================================
# AUTOMATIC JOB FETCH & CRON CONFIGURATION
# ==============================================================================

# Server-Only Service Role Key (Required for cron ingestion & scoring)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Owner User ID (Required for cron queries to scope unauthenticated tasks to your account)
# Found in: Supabase Dashboard -> Authentication -> Users -> Copy User UID
OWNER_USER_ID=your-supabase-user-uuid

# Secret for protecting POST /api/cron/fetch (Generate a 32+ char random string)
CRON_SECRET=your-random-cron-secret-token

# Daily auto-scoring cap per IST day (defaults to 30 if unset)
AUTO_SCORE_DAILY_CAP=30


# ==============================================================================
# AI MATCHER & TAILOR OUTREACH CONFIGURATION
# ==============================================================================

# Groq API Configuration (Phase 3 AI Matcher & Tailor)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
