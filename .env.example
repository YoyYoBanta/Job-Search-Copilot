# ==============================================================================
# PHASE 1 VARIABLES (Required for Phase 1)
# ==============================================================================

# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Access Control (Single-User Whitelist - Required in Phase 1)
ALLOWED_EMAIL=your-email@example.com


# ==============================================================================
# UPCOMING PHASE VARIABLES (Optional in Phase 1 - Not needed until later phases)
# ==============================================================================

# Server-Only Service Role Key (Optional in Phase 1; only needed if backend admin tasks bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq API Configuration (Phase 3 AI Matcher & Tailor)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
